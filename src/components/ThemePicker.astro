---
/* Theme picker. A button opens a panel of swatches; picking one sets
   data-theme on <html>, remembers the choice, and repaints through a View
   Transition so the whole site changes colour in one motion.
   The list is rendered at build time — the panel needs no network at all. */
import { THEMES, STORAGE_KEY } from '../themes';

const light = THEMES.filter((t) => t.light);
const dark = THEMES.filter((t) => !t.light);
---

<div class="theme-picker" data-theme-picker>
  <button
    type="button"
    class="theme-picker__trigger"
    aria-expanded="false"
    aria-haspopup="dialog"
    data-theme-trigger
  >
    <span class="theme-picker__dot" data-theme-current></span>
    <span class="theme-picker__trigger-label">Theme</span>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="theme-picker__caret">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
    </svg>
  </button>

  <!-- Always-on hint for the switcher shortcut. Not a toast, not a one-shot
       tooltip: the key stays visible so the shortcut stays discoverable. -->
  <button type="button" class="theme-chip" data-switcher-open title="Open the theme switcher (T)">
    <kbd class="theme-chip__key">T</kbd>
    <span class="theme-chip__label">Switcher</span>
  </button>

  <div class="theme-picker__panel" role="dialog" aria-label="Choose a theme" hidden data-theme-panel>
    <p class="theme-picker__heading">Dark</p>
    <div class="theme-picker__grid">
      {
        dark.map((theme) => (
          <button
            type="button"
            class="theme-picker__item"
            data-theme-id={theme.id}
            aria-label={`Use the ${theme.name} theme`}
            aria-pressed="false"
          >
            <span class="theme-picker__swatch" style={`--swatch:${theme.swatch}`} />
            <span class="theme-picker__name">{theme.name}</span>
          </button>
        ))
      }
    </div>

    <p class="theme-picker__heading">Light</p>
    <div class="theme-picker__grid">
      {
        light.map((theme) => (
          <button
            type="button"
            class="theme-picker__item"
            data-theme-id={theme.id}
            aria-label={`Use the ${theme.name} theme`}
            aria-pressed="false"
          >
            <span class="theme-picker__swatch" style={`--swatch:${theme.swatch}`} />
            <span class="theme-picker__name">{theme.name}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script define:vars={{ storageKey: STORAGE_KEY }}>
  const root = document.documentElement;
  const picker = document.querySelector('[data-theme-picker]');
  const trigger = picker?.querySelector('[data-theme-trigger]');
  const panel = picker?.querySelector('[data-theme-panel]');
  const currentDot = picker?.querySelector('[data-theme-current]');
  const items = [...(picker?.querySelectorAll('[data-theme-id]') ?? [])];

  const activeId = () => root.dataset.theme || 'tokyo-night';

  /* Reflect the live theme in the trigger and mark the chosen swatch. */
  function sync() {
    const id = activeId();
    if (currentDot) currentDot.dataset.themeCurrent = id;
    for (const item of items) {
      const on = item.dataset.themeId === id;
      item.setAttribute('aria-pressed', on ? 'true' : 'false');
    }
  }

  function setOpen(open) {
    if (!panel || !trigger) return;
    panel.hidden = !open;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  trigger?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  picker?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  /* Clicking outside closes the panel. */
  document.addEventListener('click', (e) => {
    if (!picker?.contains(e.target)) setOpen(false);
  });

  /* Draw the wipe overlay. It is a plain DOM element rather than a CSS
     pseudo-element so it can be removed on animationend and never leaks. */
  function wipe() {
    const bar = document.createElement('div');
    bar.className = 'theme-wipe';
    bar.setAttribute('aria-hidden', 'true');
    bar.addEventListener('animationend', () => bar.remove(), { once: true });
    document.body.appendChild(bar);
    /* Safety net: if animationend never fires, clear it anyway. */
    setTimeout(() => bar.remove(), 700);
  }

  /* Run the colour change inside a View Transition when the browser supports
     it, so the swap reads as one wipe instead of an abrupt repaint. */
  async function apply(id) {
    const change = () => {
      root.dataset.theme = id;
      try {
        localStorage.setItem(storageKey, id);
      } catch {
        /* Private mode — the theme still applies for this visit. */
      }
      sync();
    };

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) wipe();

    if (document.startViewTransition && !reduced) {
      try {
        await document.startViewTransition(change).finished;
      } catch {
        /* Transition cancelled (e.g. interrupted) — the change already landed. */
      }
    } else {
      change();
    }
  }

  for (const item of items) {
    item.addEventListener('click', () => {
      apply(item.dataset.themeId);
      setOpen(false);
    });
  }

  sync();
  document.addEventListener('astro:page-load', sync);

  /* The full-screen switcher (ThemeSwitcher) owns the T shortcut. It commits a
     choice through this event, so the trigger dot and the pressed swatch stay
     in step with whatever the user picked there. */
  document.addEventListener('peditx:theme', sync);
</script>

<style>
  .theme-picker {
    position: relative;
  }

  .theme-picker__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.625rem;
    border: 1px solid var(--t-border-strong);
    background: transparent;
    color: var(--t-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      border-color 120ms ease-out,
      background-color 120ms ease-out;
  }

  .theme-picker__trigger:hover {
    border-color: var(--t-brand);
    background: var(--t-brand-soft);
  }

  .theme-picker__trigger:focus-visible {
    outline: 2px solid var(--t-brand);
    outline-offset: 2px;
  }

  .theme-picker__dot {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--dot, var(--t-brand));
    flex-shrink: 0;
  }

  .theme-picker__dot[data-theme-current='catppuccin'] { --dot: #89b4fa; }
  .theme-picker__dot[data-theme-current='catppuccin-latte'] { --dot: #8839ef; }
  .theme-picker__dot[data-theme-current='ethereal'] { --dot: #a78bfa; }
  .theme-picker__dot[data-theme-current='everforest'] { --dot: #a7c080; }
  .theme-picker__dot[data-theme-current='flexoki-light'] { --dot: #b55d1c; }
  .theme-picker__dot[data-theme-current='gruvbox'] { --dot: #83a598; }
  .theme-picker__dot[data-theme-current='hackerman'] { --dot: #00ff41; }
  .theme-picker__dot[data-theme-current='kanagawa'] { --dot: #7e9cd8; }
  .theme-picker__dot[data-theme-current='last-horizon'] { --dot: #f2a25c; }
  .theme-picker__dot[data-theme-current='lumon'] { --dot: #d4b45a; }
  .theme-picker__dot[data-theme-current='lupine'] { --dot: #8f82ff; }
  .theme-picker__dot[data-theme-current='matte-black'] { --dot: #e0e0e0; }
  .theme-picker__dot[data-theme-current='miasma'] { --dot: #9bc53d; }
  .theme-picker__dot[data-theme-current='nord'] { --dot: #88c0d0; }
  .theme-picker__dot[data-theme-current='osaka-jade'] { --dot: #7ec8a0; }
  .theme-picker__dot[data-theme-current='retro-82'] { --dot: #ff6ec7; }
  .theme-picker__dot[data-theme-current='ristretto'] { --dot: #c4a484; }
  .theme-picker__dot[data-theme-current='rose-pine'] { --dot: #ebbcba; }
  .theme-picker__dot[data-theme-current='solitude'] { --dot: #7aa2f7; }
  .theme-picker__dot[data-theme-current='tokyo-night'] { --dot: #9ece6a; }
  .theme-picker__dot[data-theme-current='vantablack'] { --dot: #ffffff; }
  .theme-picker__dot[data-theme-current='white'] { --dot: #6e6e6e; }

  .theme-picker__trigger-label {
    display: none;
  }

  @media (min-width: 40rem) {
    .theme-picker__trigger-label {
      display: inline;
    }
  }

  .theme-picker__caret {
    width: 1rem;
    height: 1rem;
    color: var(--t-text-muted);
    transition: transform 160ms ease-out;
  }

  .theme-picker__trigger[aria-expanded='true'] .theme-picker__caret {
    transform: rotate(180deg);
  }

  .theme-picker__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 60;
    width: 20rem;
    max-width: calc(100vw - 2rem);
    max-height: 70vh;
    overflow-y: auto;
    padding: 1rem;
    background: var(--t-surface);
    border: 1px solid var(--t-border-strong);
    box-shadow: var(--t-elevation-hover);
  }

  .theme-picker__heading {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--t-text-muted);
  }

  .theme-picker__heading + .theme-picker__grid + .theme-picker__heading {
    margin-top: 1.25rem;
  }

  .theme-picker__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .theme-picker__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--t-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: start;
    cursor: pointer;
    transition:
      border-color 120ms ease-out,
      background-color 120ms ease-out;
  }

  .theme-picker__item:hover {
    background: var(--t-surface-2);
    border-color: var(--t-border-subtle);
  }

  .theme-picker__item:focus-visible {
    outline: 2px solid var(--t-brand);
    outline-offset: -2px;
  }

  .theme-picker__item[aria-pressed='true'] {
    border-color: var(--t-brand);
    background: var(--t-brand-soft);
    color: var(--t-text);
  }

  .theme-picker__swatch {
    width: 0.875rem;
    height: 0.875rem;
    background: var(--swatch);
    flex-shrink: 0;
  }

  .theme-picker__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* ── Persistent "T" chip ────────────────────────────────────────
     Always rendered, so the shortcut is discoverable without having to
     dismiss a notice first. Opens the full-screen switcher. */
  .theme-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3125rem 0.5rem;
    border: 1px solid var(--t-border-subtle);
    background: transparent;
    color: var(--t-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color 140ms ease-out, color 140ms ease-out;
  }

  .theme-chip:hover {
    border-color: var(--t-border-strong);
    color: var(--t-text);
  }

  .theme-chip__key {
    padding: 0 0.25rem;
    border: 1px solid var(--t-brand);
    background: var(--t-surface);
    color: var(--t-brand);
    font-family: inherit;
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .theme-chip__label {
    display: none;
  }

  @media (min-width: 30rem) {
    .theme-chip__label {
      display: inline;
    }
  }

</style>
