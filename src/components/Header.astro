---
/* Sticky header. The nav ghost over the hero is handled by mix-blend-mode in
   the hero itself, so this stays a plain bar. */
import ThemePicker from './ThemePicker.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';

const nav = [
  { href: '#projects', label: 'Projects' },
  { href: '#videos', label: 'Videos' },
  { href: '#music', label: 'Music' },
  { href: '#connect', label: 'Connect' },
  { href: '#about', label: 'About' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="#top" class="site-header__brand" aria-label="PeDitX — home">
      <span class="site-header__mark" aria-hidden="true">PX</span>
      <span class="site-header__word">PeDitX</span>
    </a>

    <nav class="site-header__nav" aria-label="Sections">
      {
        nav.map((item) => (
          <a href={item.href} class="site-header__link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <ThemePicker />
      <a
        href="https://github.com/peditx"
        class="site-header__icon"
        aria-label="GitHub"
        rel="noopener me"
        target="_blank"
      >
        <svg class="site-header__icon-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.73 18.27.5 12 .5Z"></path>
        </svg>
      </a>
    </div>
  </div>

  <ThemeSwitcher />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--t-bg);
    border-bottom: 1px solid var(--t-border-subtle);
  }

  /* Three equal columns, so the nav lands on the true centre of the viewport
     rather than in whatever gap the brand and the actions happen to leave. */
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    max-width: 72rem;
    margin-inline: auto;
    height: 3.5rem;
    padding-inline: 1rem;
  }

  /* Pin each region to its column. Without this, hiding the nav on small
     screens collapses the grid to two items and the actions slide into the
     centre column instead of staying pinned to the trailing edge. */
  .site-header__brand {
    grid-column: 1;
    justify-self: start;
  }

  .site-header__actions {
    grid-column: 3;
    justify-self: end;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--t-text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__brand:focus-visible {
    outline: 2px solid var(--t-brand);
    outline-offset: 2px;
  }

  .site-header__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    background: var(--t-brand);
    color: var(--t-brand-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .site-header__word {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .site-header__nav {
    grid-column: 2;
    display: none;
    align-items: center;
    gap: 0.25rem;
    justify-self: center;
  }

  @media (min-width: 48rem) {
    .site-header__nav {
      display: flex;
    }
  }

  .site-header__link {
    padding: 0.375rem 0.625rem;
    color: var(--t-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 120ms ease-out;
  }

  .site-header__link:hover {
    color: var(--t-brand);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--t-brand);
    outline-offset: 2px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .site-header__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--t-text-secondary);
    transition: color 120ms ease-out;
  }

  .site-header__icon:hover {
    color: var(--t-brand);
  }

  .site-header__icon:focus-visible {
    outline: 2px solid var(--t-brand);
    outline-offset: 2px;
  }

  /* Direct class on the element rather than a descendant selector: Astro's
     scoping attribute can collide with the tag in minified output. */
  .site-header__icon-svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
