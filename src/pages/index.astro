---
/* The home page. Everything here is rendered at build time: the projects,
   links and videos come straight out of the content collections, so the HTML
   that ships already contains the text a search engine reads. No client-side
   templating anywhere in this file. */
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PixelWordmark from '../components/PixelWordmark.astro';
import { THEMES } from '../themes';
import order from '../content/order.json';
import site from '../content/site.json';

/* order.json decides how the lists read — the panel rewrites it to reorder
   them. Anything it does not name drops to the end, keeping the order the
   collection itself returned. Entries are keyed by file name, with the id as
   a fallback for the two files that set `slug` by hand. */
const byOrder = (list, keys) => {
  const at = new Map((keys || []).map((k, i) => [k, i]));
  const rank = (entry) => {
    const file = (entry.filePath || '').split('/').pop();
    return at.has(file) ? at.get(file) : at.has(entry.id) ? at.get(entry.id) : Infinity;
  };
  return [...list].sort((a, b) => rank(a) - rank(b));
};

const projects = byOrder(await getCollection('projects'), order.projects);
const links = await getCollection('links');
const videos = byOrder(await getCollection('videos'), order.videos);

/* Only fields that must reach the client. */
const soundcloudPlaylistUrl = 'https://soundcloud.com/peditx/sets/pedram-peditx-old-singles';

const sections = [
  { id: 'projects', num: '01', kicker: 'Creations', title: 'Projects' },
  { id: 'videos', num: '02', kicker: 'On YouTube', title: 'Videos' },
  { id: 'music', num: '03', kicker: 'Since 2005', title: 'Music' },
  { id: 'connect', num: '04', kicker: 'Find me', title: 'Connect' },
  { id: 'about', num: '05', kicker: 'Background', title: 'About' },
] as const;

/* Structured data for search engines. Rendered inline as JSON-LD.
   WebSite + Person is what feeds Google's knowledge panel: the sameAs list
   ties every profile to this domain. VideoObject is what earns video rich
   results. Everything is derived from the collections so the panel never has
   to touch this file. */
const siteUrl = 'https://codes.peditx.ir';
/* site.json is edited from the panel. Three different pictures on purpose:
   the knowledge panel wants a photo of the person, the social preview wants
   the brand, and WebSite.logo wants the mark itself. */
const profileImage = new URL(site.profileImage, siteUrl).href;
const websiteImage = new URL(site.websiteImage, siteUrl).href;
const logoImage = new URL(site.logo, siteUrl).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PeDitX',
  url: siteUrl,
  description: site.description,
  image: websiteImage,
  logo: logoImage,
  inLanguage: ['en', 'fa'],
  author: { '@type': 'Person', name: 'PeDitX', url: siteUrl },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'PeDitX',
  alternateName: 'Pedram Alemahmoud',
  givenName: 'Pedram',
  familyName: 'Alemahmoud',
  jobTitle: ['Developer', 'Musician', 'Actor', 'Content Creator'],
  url: 'https://codes.peditx.ir',
  description: site.description,
  image: profileImage,
  sameAs: links.map((l) => l.data.url),
  knowsAbout: ['OpenWrt', 'Linux', 'Network engineering', 'Music production', 'Film directing'],
  birthDate: '1988-06-06',
  birthPlace: { '@type': 'Place', name: 'Ahvaz, Iran' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Tehran' },
    { '@type': 'CollegeOrUniversity', name: 'Central Tehran Azad University' },
  ],
};

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'PeDitX videos',
  itemListElement: videos.map((video, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: video.data.title,
      description: video.data.title,
      thumbnailUrl: [
        video.data.thumbnailUrl ?? `https://i.ytimg.com/vi/${video.data.videoId}/hqdefault.jpg`,
      ],
      contentUrl: `https://www.youtube.com/watch?v=${video.data.videoId}`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${video.data.videoId}`,
      /* No uploadDate: the videos collection has no date field, and a wrong
         one is worse than none. Add `pubDate` to the schema to enable it. */
      author: { '@type': 'Person', name: 'PeDitX' },
    },
  })),
};

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'PeDitX projects',
  itemListElement: projects.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: project.data.name,
      description: project.data.description,
      url: project.data.url,
      codeRepository: project.data.url,
      author: { '@type': 'Person', name: 'PeDitX' },
    },
  })),
};
---

<Layout
  title="PeDitX — Developer, Musician, Actor"
  description={site.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />

  <Header />

  <main id="main">
    <!-- ── Hero ─────────────────────────────────────────────────────── -->
    <section id="top" class="hero" aria-label="Introduction">
      <canvas class="hero__glow" data-hero-glow aria-hidden="true"></canvas>
      <div class="hero__inner">
        <p class="hero__kicker hero-rise" style="--rise-index: 0">
          <span class="hero__cursor caret-blink" aria-hidden="true"></span>
          <span id="tagline">Developer · Musician · Actor · Creator</span>
        </p>

        <h1 class="hero__wordmark hero-rise" style="--rise-index: 1">
          <span class="sr-only">PeDitX</span>
          <PixelWordmark />
        </h1>

        <p class="hero__lead hero-rise" style="--rise-index: 2">
          I build <strong>PeDitXOS</strong> and a set of <strong>OpenWrt</strong> packages, I have
          released around 169 single tracks, and I act in theatre and short film.
        </p>

        <div class="hero__actions hero-rise" style="--rise-index: 3">
          <a href="#projects" class="btn btn--primary">See the projects</a>
          <a
            href="https://github.com/peditx"
            class="btn"
            rel="noopener"
            target="_blank"
          >
            GitHub
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="btn__arrow">
              <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
              <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
            </svg>
          </a>
        </div>

        <dl class="hero__stats hero-rise" style="--rise-index: 4">
          <div class="hero__stat">
            <dt>Themes</dt>
            <dd>{THEMES.length}</dd>
          </div>
          <div class="hero__stat">
            <dt>Projects</dt>
            <!-- ponytail: hand-written totals, not content counts — the repo
                 only carries the pick of them. Swap back to {projects.length}
                 if the archive is ever fully migrated here. -->
            <dd>160+</dd>
          </div>
          <div class="hero__stat">
            <dt>Videos</dt>
            <dd>200+</dd>
          </div>
          <div class="hero__stat">
            <dt>Active since</dt>
            <dd>2005</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ── Ticker ──────────────────────────────────────────────────── -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          Array.from({ length: 2 }).map(() => (
            <span class="marquee__set">
              <span>PeDitXOS</span>
              <span>OpenWrt packages</span>
              <span>LuCI themes</span>
              <span>Rap &amp; metal</span>
              <span>Theatre</span>
              <span>Short film</span>
              <span>Network tooling</span>
              <span>Since 2005</span>
            </span>
          ))
        }
      </div>
    </div>

    <!-- ── Projects ─────────────────────────────────────────────────── -->
    <section id="projects" class="band" data-reveal>
      <div class="band__inner">
        <header class="band__head">
          <span class="band__num" aria-hidden="true">01</span>
          <h2 class="band__title">Projects</h2>
          <p class="band__lead">
            The operating system, packages and themes I built and shipped.
          </p>
        </header>

        <ul class="cards" data-reveal-stagger>
          {
            projects.map((project, i) => (
              <li class="cards__item" style={`--i:${i}`}>
                <a
                  href={project.data.url}
                  class="card"
                 
                  rel="noopener"
                  target="_blank"
                >
                  <span class="card__body">
                    <span class="card__title">{project.data.name}</span>
                    <span class="card__desc">{project.data.description}</span>
                  </span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="card__arrow">
                    <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
                    <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Videos ───────────────────────────────────────────────────── -->
    <section id="videos" class="band band--deep" data-reveal>
      <div class="band__inner">
        <header class="band__head">
          <span class="band__num" aria-hidden="true">02</span>
          <h2 class="band__title">Videos</h2>
          <p class="band__lead">Technology and networking, on YouTube.</p>
        </header>

        <ul class="reel" data-reveal-stagger>
          {
            videos.map((video, i) => (
              <li class="reel__item" style={`--i:${i}`}>
                <a
                  href={`https://www.youtube.com/watch?v=${video.data.videoId}`}
                  class="reel__card"
                 
                  rel="noopener"
                  target="_blank"
                >
                  <span class="reel__thumb">
                    <img
                      src={
                        video.data.thumbnailUrl ??
                        `https://i.ytimg.com/vi/${video.data.videoId}/hqdefault.jpg`
                      }
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="480"
                      height="360"
                    />
                    <span class="reel__play" aria-hidden="true">
                      <svg class="reel__play-svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5.5v13l11-6.5-11-6.5Z"></path>
                      </svg>
                    </span>
                  </span>
                  <span class="reel__title">{video.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Music ────────────────────────────────────────────────────── -->
    <section id="music" class="band" data-reveal>
      <div class="band__inner">
        <header class="band__head">
          <span class="band__num" aria-hidden="true">03</span>
          <h2 class="band__title">Music</h2>
          <p class="band__lead">
            Around 169 single tracks between 2005 and 2020, in rap and metal.
          </p>
        </header>

        <div class="visualiser">
          <div class="visualiser__rings" aria-hidden="true">
            <span class="music-ring"></span>
            <span class="music-ring"></span>
            <span class="music-ring"></span>
          </div>

          <div class="player">
            <iframe
              title="PeDitX on SoundCloud"
              width="100%"
              height="300"
              loading="lazy"
              allow="autoplay"
              src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(soundcloudPlaylistUrl)}&color=%239ece6a&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`}
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Connect ──────────────────────────────────────────────────── -->
    <section id="connect" class="band band--deep" data-reveal>
      <div class="band__inner">
        <header class="band__head">
          <span class="band__num" aria-hidden="true">04</span>
          <h2 class="band__title">Connect</h2>
          <p class="band__lead">Find me on these platforms.</p>
        </header>

        <ul class="links" data-reveal-stagger>
          {
            links.map((link, i) => (
              <li class="links__item" style={`--i:${i}`}>
                <a
                  href={link.data.url}
                  class="links__card"
                 
                  rel="noopener me"
                  target="_blank"
                >
                  <svg
                    class="links__icon-svg"
                    viewBox="0 0 24 24"
                    fill={link.data.solid ? 'currentColor' : 'none'}
                    stroke={link.data.solid ? 'none' : 'currentColor'}
                    stroke-width={link.data.solid ? 0 : 2}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={link.data.icon}
                    aria-hidden="true"
                  />
                  <span class="links__name">{link.data.name}</span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="links__arrow">
                    <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
                    <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── About ────────────────────────────────────────────────────── -->
    <section id="about" class="band" data-reveal>
      <div class="band__inner band__inner--narrow">
        <header class="band__head">
          <span class="band__num" aria-hidden="true">05</span>
          <h2 class="band__title">About</h2>
        </header>

        <div class="about">
          <p>
            <strong>Pedram Alemahmoud</strong>, known as <strong>PeDitX</strong>, was born on 6 June
            1988 in Ahvaz, Khuzestan, and lives in Tehran.
          </p>
          <p>
            He holds a BA in acting from the University of Tehran and an MA in directing from
            Central Tehran Azad University. His media work began in 2005 as a camera operator and
            lighting engineer for IRIB. He presented television in 2008, on <em>Darshahr</em> and
            <em>Fanavaraneh</em>, and narrated the radio programme <em>Arghanoon</em> in 2020.
          </p>
          <p>
            He has been making music since 2005, and has acted in stage plays and short films since
            2013.
          </p>

          <a
            href="https://www.imdb.com/name/nm14063328/"
            class="btn btn--quiet"
            rel="noopener"
            target="_blank"
          >
            View on IMDb
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="btn__arrow">
              <path d="M14 5.75L20.25 12L14 18.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
              <path d="M19.5 12H3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <span class="site-footer__mark" aria-hidden="true">PX</span>
      <p class="site-footer__text">
        © {new Date().getFullYear()} PeDitX · Pedram Alemahmoud. All rights reserved.
      </p>
      <p class="site-footer__meta">
        Built with Astro · {THEMES.length} themes · No trackers
      </p>
    </div>
  </footer>


  <script>
    /* Backlight behind the wordmark.
     Horizontal: follows the pointer and is wide enough to cover the mark end
     to end, so the strip never breaks as the cursor crosses it.
     Vertical: anchored to the mark and only a few millimetres taller than it,
     so the light fades just past the top and bottom of the lettering. */
  const glow = document.querySelector<HTMLCanvasElement>('[data-hero-glow]');
  const heroEl = document.querySelector<HTMLElement>('.hero');
  const markEl = document.querySelector<HTMLElement>('[data-pixel-wordmark]');
  if (glow && heroEl && markEl) {
    const gctx = glow.getContext('2d');
    const BLOCK = 10; /* css px — the grain of the light */
    let gw = 0;
    let gh = 0;
    let gdpr = 1;
    let pointerX = NaN;
    let pointerY = NaN;
    let brand = [125, 216, 125];

    const readBrand = () => {
      const v = getComputedStyle(document.documentElement).getPropertyValue('--t-brand').trim();
      const s = v.replace('#', '');
      if (s.length >= 6) {
        const n = parseInt(s.slice(0, 6), 16);
        brand = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
    };

    /* A disc that tracks the pointer. Radial by construction — one radius for
       both axes — so it stays a circle wherever the cursor is, and the fall-off
       is gentle enough that no contour is visible against the lettering. */
    const drawGlow = () => {
      if (!gctx) return;
      gctx.setTransform(1, 0, 0, 1, 0, 0);
      gctx.clearRect(0, 0, gw, gh);
      const heroR = heroEl.getBoundingClientRect();
      const markR = markEl.getBoundingClientRect();
      if (heroR.width < 2 || markR.height < 2) return;
      if (Number.isNaN(pointerX) || Number.isNaN(pointerY)) return;

      const b = BLOCK * gdpr;
      const cols = Math.ceil(gw / b);
      const rows = Math.ceil(gh / b);
      const cx = pointerX * gdpr;
      const cy = pointerY * gdpr;
      const R = markR.height * 0.22 * gdpr;
      const gap = b * 0.12;

      /* The background keeps a quiet circle at the centre of the page, and the
         light is only allowed inside it — everywhere else the page belongs to
         the dust. Published by PixelDust so the two never drift apart. */
      const ring = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--bg-circle-r')
      );
      const ringR = Number.isFinite(ring) && ring > 0 ? ring * gdpr : Infinity;
      const ringX = (heroR.left + window.innerWidth / 2) * gdpr;
      const ringY = (heroR.top + window.innerHeight / 2) * gdpr;

      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const bx = gx * b + b / 2;
          const by = gy * b + b / 2;
          const rx = bx - cx;
          const ry2 = by - cy;
          if (rx * rx + ry2 * ry2 >= R * R) continue;
          const qx = bx - ringX;
          const qy = by - ringY;
          if (qx * qx + qy * qy >= ringR * ringR) continue;
          const d = Math.hypot(rx, ry2) / R;
          const a = 0.5 * (1 - Math.pow(d, 1.4));
          if (a <= 0.003) continue;
          gctx.fillStyle = `rgba(${brand[0]}, ${brand[1]}, ${brand[2]}, ${a})`;
          gctx.fillRect(gx * b, gy * b, b - gap, b - gap);
        }
      }
    };

    const sizeGlow = () => {
      const r = heroEl.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return;
      gdpr = Math.min(window.devicePixelRatio || 1, 2);
      gw = Math.round(r.width * gdpr);
      gh = Math.round(r.height * gdpr);
      glow.width = gw;
      glow.height = gh;
      drawGlow();
    };

    let queued = false;
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        drawGlow();
      });
    };

    heroEl.addEventListener('pointermove', (e) => {
      const r = heroEl.getBoundingClientRect();
      pointerX = e.clientX - r.left;
      pointerY = e.clientY - r.top;
      queue();
    });
    heroEl.addEventListener('pointerleave', () => {
      pointerX = NaN;
      pointerY = NaN;
      queue();
    });
    new ResizeObserver(sizeGlow).observe(heroEl);
    new MutationObserver(() => {
      readBrand();
      queue();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    readBrand();
    sizeGlow();
  }

  /* Scroll reveal. The hidden state lives in CSS, but it is only reached
       because this script runs — without JavaScript every section stays
       visible. Elements already on screen are revealed immediately so the
       fold never flashes. Each element is observed once. */
    const targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      targets.forEach((el) => io.observe(el));
    }

    /* Pause the ticker when the tab is hidden so it does not burn frames in
       the background. */
    document.addEventListener('visibilitychange', () => {
      document.documentElement.classList.toggle('tab-hidden', document.hidden);
    });
  </script>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--t-border-subtle);
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 6rem);
  }

  .hero__inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
    text-align: center;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__kicker {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--t-text-muted);
  }

  /* The blink itself comes from the global .caret-blink class, so reduced
     motion and the theme picker both stay in sync from one definition. */
  .hero__cursor {
    width: 0.5rem;
    height: 1rem;
    background: var(--t-brand);
  }

  /* The headline is painted as a pixel grid by PixelWordmark, so the text
     itself is only a screen-reader fallback. No type styles needed here
     beyond the box: the canvas sets the size through its aspect ratio. */
  .hero__wordmark {
    max-width: 56rem;
    /* Centred: without this the fixed max-width left-aligns it inside the
       wider content column, which put the wordmark off-centre. */
    margin-inline: auto;
    margin-block: 0;
    font-family: inherit;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero__lead {
    max-width: 40rem;
    margin: 1.75rem auto 0;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--t-text-secondary);
  }

  .hero__lead strong {
    color: var(--t-text);
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 3.5rem 0 0;
    padding: 1px;
    background: var(--t-border-subtle);
    border: 1px solid var(--t-border-subtle);
  }

  @media (min-width: 48rem) {
    .hero__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

